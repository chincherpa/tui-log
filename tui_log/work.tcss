/* tui_log/work.tcss – Styles für den Work-Modus */

/* ── Globales Layout ─────────────────────────────────────────── */

Screen {
    background: #0D0D1A;
    color: #C8C8C8;
}

Header {
    background: #1A1A2E;
    color: #5B8DEF;
    height: 1;
    dock: top;
}

Footer {
    background: #1A1A2E;
    color: #555577;
    height: 1;
}

/* ── Haupt-Split ─────────────────────────────────────────────── */

#main-split {
    layout: horizontal;
    height: 1fr;
}

/* ── Log-Panel (links, breiter) ──────────────────────────────── */

#log-panel {
    width: 2fr;
    border: solid #2A2A44;
    background: #0D0D1A;
    padding: 0 1;
}

#log-panel:focus-within {
    border: solid #5B8DEF;
}

#log-panel-title {
    background: #1A1A2E;
    color: #5B8DEF;
    height: 1;
    padding: 0 1;
    text-style: bold;
    width: 100%;
}

/* Log-Filter-Leiste */
#log-filter-bar {
    height: 1;
    background: #12122A;
    color: #C8C8C8;
    padding: 0 0;
    width: 100%;
}

/* Carry-over Warnung */
#carry-over-bar {
    height: auto;
    background: #1A0A0A;
    color: #FF6B6B;
    padding: 0 1;
    display: none;
}

#carry-over-bar.visible {
    display: block;
}

/* Log-Einträge */
#log-list {
    height: 1fr;
    overflow-y: auto;
    scrollbar-gutter: stable;
    scrollbar-color: #2A2A44 #0D0D1A;
}

/* Schnell-Eingabe */
#log-input-row {
    height: 3;
    layout: horizontal;
    background: #0D1A0D;
    border-top: solid #2A2A44;
    padding: 0 1;
    align: left middle;
}

#tag-selector {
    width: auto;
    min-width: 12;
    height: 1;
    background: #1A2A1A;
    color: #00C896;
    text-style: bold;
    padding: 0 1;
    margin-right: 1;
    border: none;
}

#log-text-input {
    width: 1fr;
    height: 1;
    background: #0D1A0D;
    color: #E8E8E8;
    border: none;
    padding: 0;
}

#log-text-input:focus {
    border: none;
    background: #0D1A0D;
}

/* ── Todo-Panel (rechts) ─────────────────────────────────────── */

#todo-panel {
    width: 1fr;
    border: solid #2A2A44;
    background: #0D0D1A;
    padding: 0 1;
}

#todo-panel:focus-within {
    border: solid #5B8DEF;
}

#todo-panel-title {
    background: #1A1A2E;
    color: #5B8DEF;
    height: 1;
    padding: 0 1;
    text-style: bold;
    width: 100%;
}

/* Aktive Session Badge */
#active-session-bar {
    height: 1;
    background: #001A10;
    color: #00C896;
    padding: 0 1;
    display: none;
}

#active-session-bar.visible {
    display: block;
}

/* Todo-Liste */
#todo-list {
    height: 1fr;
    overflow-y: auto;
    scrollbar-color: #2A2A44 #0D0D1A;
}

/* ── Log-Eintrag Zeile ───────────────────────────────────────── */

.log-entry {
    height: 1;
    layout: horizontal;
    padding: 0 0;
}

.log-time {
    width: 6;
    color: #555577;
}

.log-tag {
    width: 10;
    text-style: bold;
}

.log-tag-done   { color: #00C896; }
.log-tag-start  { color: #5B8DEF; }
.log-tag-block  { color: #FF6B6B; }
.log-tag-idea   { color: #C77DFF; }
.log-tag-fix    { color: #FFD93D; }
.log-tag-deploy { color: #4FC3F7; }
.log-tag-meet   { color: #FF9A3C; }
.log-tag-note   { color: #888888; }

.log-content {
    width: 1fr;
    color: #C8C8C8;
}

.log-entry-carry {
    height: 1;
    color: #FF6B6B;
    padding: 0 1;
}

/* ── Todo-Eintrag ────────────────────────────────────────────── */

.todo-item {
    height: 2;
    padding: 0 0;
    border-bottom: solid #1A1A2E;
}

.todo-item:hover {
    background: #1A1A2E;
}

.todo-item.--highlight {
    background: #1A2A3A;
}

.todo-title-row {
    layout: horizontal;
    height: 1;
}

.todo-status-icon {
    width: 3;
    color: #555577;
}

.todo-title {
    width: 1fr;
    color: #C8C8C8;
}

.todo-title.priority-high {
    color: #FF6B6B;
    text-style: bold;
}

.todo-title.status-done {
    color: #444466;
}

.todo-meta-row {
    layout: horizontal;
    height: 1;
    padding-left: 3;
}

.todo-context {
    color: #555577;
    width: 1fr;
}

.todo-stats {
    color: #444466;
    width: auto;
}

/* ── Focus Modal ─────────────────────────────────────────────── */

FocusModal {
    align: center middle;
}

#focus-dialog {
    background: #0A0A1A;
    border: solid #5B8DEF;
    width: 68;
    height: auto;
    padding: 1 2;
}

#focus-todo-title {
    color: #E8E8E8;
    text-style: bold;
    height: 1;
}

#focus-todo-context {
    color: #555577;
    height: 1;
    margin-bottom: 1;
}

#focus-timer-display {
    color: #00C896;
    text-style: bold;
    height: 1;
    content-align: center middle;
    margin-bottom: 1;
}

#focus-timer-bar {
    height: 1;
    margin-bottom: 1;
}

#focus-notes-label {
    color: #5B8DEF;
    text-style: bold;
    height: 1;
}

#focus-notes-list {
    height: 6;
    overflow-y: auto;
    background: #080818;
    border: solid #1A1A2E;
    padding: 0 1;
    margin-bottom: 1;
}

.focus-note-line {
    height: 1;
    color: #C8C8C8;
}

.focus-note-time {
    color: #555577;
    width: 7;
}

#focus-note-input {
    background: #0D1A0D;
    color: #E8E8E8;
    border: solid #2A4A2A;
    margin-bottom: 1;
}

#focus-note-input:focus {
    border: solid #00C896;
}

#focus-context-label {
    color: #555577;
    text-style: bold;
    height: 1;
}

.focus-context-line {
    height: 1;
    color: #666688;
}

#focus-hint {
    color: #555577;
    height: 1;
    margin-top: 1;
}

/* ── Feierabend Modal ────────────────────────────────────────── */

HandoverModal {
    align: center middle;
}

#handover-dialog {
    background: #1A0D0D;
    border: solid #FF9A3C;
    width: 64;
    height: auto;
    padding: 1 2;
}

#handover-title {
    color: #FF9A3C;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

.handover-label {
    color: #C8C8C8;
    text-style: bold;
    height: 1;
}

.handover-input {
    background: #2A1A0A;
    color: #E8E8E8;
    border: solid #442A0A;
    margin-bottom: 1;
}

.handover-input:focus {
    border: solid #FF9A3C;
}

#handover-rating-display {
    color: #FF9A3C;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#handover-hint {
    color: #555577;
    height: 1;
}
